# ── Environment Variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The backend will use OPENAI_API_KEY for GPT-powered baseline inference.
# If left empty, the rule-based fallback agent is used automatically.

# Optional: OpenAI API key for GPT-3.5 Turbo baseline inference
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
